# RogMitra Server Configuration
PROJECT_NAME="RogMitra"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./rogmitra.db"

# Demo & Prototyping Modes
DEMO_MODE=True
DEMO_OTP="123456"
DEMO_LOGIN_OPEN=true

# ASR & OCR Service Config
USE_BROWSER_SPEECH_FALLBACK=True
TESSERACT_CMD_PATH="" # Optional: C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional LLM Provider for adaptive interview follow-up (gemini | ollama | none)
# Rule 5: Configured on server-side only; NEVER expose API keys in frontend.
LLM_PROVIDER="none"
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
